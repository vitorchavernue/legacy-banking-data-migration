model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder", "Runs", "Source Tables", "Coverage", "Backlog", "Checks", "Run Volumes", "Rejected Records"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Runs
ref table 'Source Tables'
ref table Coverage
ref table Backlog
ref table Checks
ref table 'Run Volumes'
ref table 'Rejected Records'

